def check_brackets(s: str) -> bool:
    matching = {')': '(', ']': '[', '}': '{'}
    stack = []
    for char in s:
        if char in "([{":
            stack.append(char)
        elif char in ")]}":
            if not stack:
                return False
            if stack[-1] != matching[char]:
                return False
            stack.pop()
        else:
            return False
    return len(stack) == 0
user_input = input("Ввод: ")
if check_brackets(user_input):
    print("Правильно")
else:
    print("Неправильно")
