point = (5, 12)

print("x =", point)  # Элемент с индексом 0 — это x
print("y =", point)  # Элемент с индексом 1 — это y  [1](https://stepik.org/lesson/443989/step/1)

a, b = point
print("a =", a, ", b =", b)

print("Сумма:", a + b)

new_point = (a * 2, b * 2)

print("Новый кортеж:", new_point)
